    {
      "itemIdentifier": "ogc.api.processes.part2.requirements.dru",
      "name": "Deploy, Replace, Undeploy",
      "abstract": "Core requirements class for OGC API \u2014 Processes Part 2 (DRAFT). Specifies the fundamental operations a server must support to dynamically deploy, replace, undeploy processes, and retrieve the last application package used to deploy or replace a process: POST /processes, PUT /processes/{processID}, DELETE /processes/{processID}, and GET /processes/{processID}/package.",
      "status": "under-development",
      "dateTimeAddition": "2026-08-03T00:00:00Z",
