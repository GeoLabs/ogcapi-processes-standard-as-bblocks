    rdfs:label "Deploy, Replace, Undeploy" ;
    dct:abstract "Core requirements class for OGC API — Processes Part 2 (DRAFT). Specifies the fundamental operations a server must support to dynamically deploy, replace, undeploy processes, and retrieve the last application package used to deploy or replace a process: POST /processes, PUT /processes/{processID}, DELETE /processes/{processID}, and GET /processes/{processID}/package."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-08-03T00:00:00+00:00"^^xsd:dateTime ;
