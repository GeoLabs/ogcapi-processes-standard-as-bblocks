            rdfs:isDefinedBy <https://geolabs.github.io/ogcapi-processes-standard-as-bblocks/bblock/ogc.api.processes.part2.requirements.dru> ] ;
    dct:hasVersion "1.0.0" ;
    dct:modified "2026-08-03"^^xsd:date ;
