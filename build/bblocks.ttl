        <bblocks://ogc.api.processes.part2.requirements.docker>,
        <bblocks://ogc.api.processes.part2.requirements.dru>,
        <bblocks://ogc.api.processes.part2.requirements.ogcapppkg>,
        <bblocks://ogc.api.processes.part2.schemas.executionUnit>,
        <bblocks://ogc.api.processes.part2.schemas.executionUnitBase>,
        <bblocks://ogc.api.processes.part2.schemas.executionUnitContainer>,
        <bblocks://ogc.api.processes.part2.schemas.inputBinding>,
