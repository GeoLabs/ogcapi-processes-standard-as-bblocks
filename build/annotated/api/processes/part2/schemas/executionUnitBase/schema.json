{
  "oneOf": [
    {
      "$ref": "https://ogcincubator.github.io/bblocks-ogcapi-processes/build/annotated/api/processes/v1/schemas/link/schema.json"
    },
    {
      "allOf": [
        {
          "$ref": "https://geolabs.github.io/ogcapi-processes-standard-as-bblocks/build/annotated/api/processes/part2/schemas/qualifiedValue/schema.json"
        },
        {
          "anyOf": [
            {
              "description": "The execution unit is a container image. The full schema for this branch's\n`value` property (executionUnitContainer.yaml in the upstream draft) is out of\nscope until the \"Docker\" conformance class is built in this register.",
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "docker",
                    "oci"
                  ]
                },
                "value": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            {
              "description": "The execution unit is CWL script.",
              "type": "object",
              "required": [
                "mediaType"
              ],
              "properties": {
                "mediaType": {
                  "type": "string",
                  "enum": [
                    "application/cwl"
                  ]
                },
                "value": {
                  "$ref": "https://raw.githubusercontent.com/common-workflow-language/cwl-v1.2/main/json-schema/cwl.yaml"
                }
              }
            },
            {
              "description": "The execution unit is not Docker/OCI or CWL and cannot be properly described via\nthe \"mediaType\" property of a qualified value using an RFC 2046 media type (e.g.\nan \"R\" or \"Python\" script). In this case a community-defined or custom token may\nbe used with the \"type\" property.",
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}